{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/images/anko-4-2.png",
    "width": 40,
    "padding": {
      "top": 2
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "╭────────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#38} user     {#keys}│",
      "type": "title",
      "format": "{user-name}"
    },
    {
      "key": "│ {#36}󰇅 hname    {#keys}│",
      "type": "title",
      "format": "{host-name}"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "type": "command",
      "key": "│ {#34}󱦟 os age   {#keys}│",
      "text": "printf \"\\e[0m%s days\\e[0m\" \"$(( ($(date +%s) - $(stat -c %W /)) / 86400 ))\""
    },
    {
      "key": "│ {#35}󰅐 distro   {#keys}│",
      "type": "os"
    },
    {
      "key": "│ {#36} kernel   {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#34}󰅐 uptime   {#keys}│",
      "type": "uptime"
    },
    {
      "key": "│ {#35}󰏖 pkgs     {#keys}│",
      "type": "packages"
    },
    {
      "key": "│ {#36} shell    {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#34}󰗊 locale   {#keys}│",
      "type": "locale"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#35}󰍹 display  {#keys}│",
      "type": "display"
    },
    {
      "key": "│ {#36}󰇄 desktop  {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#34} wm       {#keys}│",
      "type": "wm"
    },
    {
      "key": "│ {#35}󰉼 theme    {#keys}│",
      "type": "wmtheme"
    },
    {
      "key": "│ {#36} term     {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#34} font     {#keys}│",
      "type": "terminalfont"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#35}󰍛 cpu      {#keys}│",
      "type": "cpu"
    },
    {
      "key": "│ {#36}󰢮 gpu      {#keys}│",
      "type": "gpu"
    },
    {
      "key": "│ {#34} memory   {#keys}│",
      "type": "memory"
    },
    {
      "key": "│ {#35}󰓡 swap     {#keys}│",
      "type": "swap"
    },
    {
      "key": "│ {#36}󰉉 disk     {#keys}│",
      "type": "disk"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#34}󰩟 local ip {#keys}│",
      "type": "localip"
    },
    {
      "key": "│ {#35}󰁹 battery  {#keys}│",
      "type": "battery"
    },
    {
      "key": "│ {#36}󰚥 power    {#keys}│",
      "type": "poweradapter"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#36} colors   {#keys}│",
      "type": "colors",
      "symbol": "circle"
    },
    {
      "key": "╰────────────╯",
      "type": "custom"
    }
  ]
}