#!/bin/bash
# battery-mode — Modos de energía (Intel + NVIDIA Optimus, Hyprland/Wayland)
# Uso: battery-mode --off | --low | --high | --gaming
#
# ── REQUISITO ÚNICO, FUERA de este script (una sola vez) ────────────────────
#   sudo systemctl enable --now auto-cpufreq
#   sudo systemctl enable --now tlp
#
#   En /etc/tlp.conf deja SIN descomentar (valor por defecto: <none>):
#     CPU_SCALING_GOVERNOR_ON_AC / _ON_BAT
#     CPU_ENERGY_PERF_POLICY_ON_AC / _ON_BAT
#     CPU_BOOST_ON_AC / _ON_BAT
#     CPU_DRIVER_OPMODE_ON_AC / _ON_BAT
#     PLATFORM_PROFILE_ON_AC / _ON_BAT
#   Verificar con:
#     grep -E "^(CPU_|PLATFORM_PROFILE_)" /etc/tlp.conf
#   (no debe imprimir nada). Esto evita que TLP y auto-cpufreq peleen por el
#   mismo governor — ver aviso oficial:
#   https://github.com/AdnanHodzic/auto-cpufreq#3-tlp
#
# ── Reparto de responsabilidades ─────────────────────────────────────────────
#   auto-cpufreq -> único dueño del CPU governor y turbo boost
#   TLP          -> USB autosuspend, PCIe ASPM, runtime PM, sonido (siempre
#                   corriendo en segundo plano, este script no lo toca)
#   battery-mode -> GPU (envycontrol), WiFi/Bluetooth, apagado de pantalla

MODE=$1
NEEDS_REBOOT=""

notify() {
    notify-send "🔋 Modo batería" "$1" --urgency=normal 2>/dev/null || echo "$1"
}

# Pide sudo una sola vez al inicio para no interrumpir el resto del script
# con varios prompts de contraseña.
sudo -v || { echo "[battery-mode] Se requiere sudo." >&2; exit 1; }

WIFI_IFACE=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)

kill_swayidle() {
    pkill -x swayidle 2>/dev/null
    sleep 0.3
}

# Aplica governor + turbo vía las banderas oficiales de auto-cpufreq.
# No arranca/detiene el daemon: se asume auto-cpufreq.service ya activo
# (ver cabecera). Por eso NO se escribe nunca directamente en
# /sys/devices/system/cpu/intel_pstate/no_turbo: si el daemon sigue vivo,
# reescribe ese archivo en su próximo ciclo y "revierte" el cambio manual —
# esa era la causa real del bug en --high.
set_cpu_profile() {
    local governor=$1   # powersave | performance | reset
    local turbo=$2       # never | always | auto
    if ! sudo auto-cpufreq --force="$governor"; then
        echo "[battery-mode] ERROR: falló 'auto-cpufreq --force=$governor'." >&2
        echo "[battery-mode] ¿Está activo el daemon? -> systemctl status auto-cpufreq" >&2
        return 1
    fi
    sudo auto-cpufreq --turbo="$turbo"
}

# Cambia de modo de GPU solo si hace falta (evita pedir reboot cuando ya
# estás en el modo correcto) y marca NEEDS_REBOOT si hubo cambio real.
gpu_switch() {
    local target=$1
    shift
    local current
    current=$(envycontrol --query 2>/dev/null)
    if [ "$current" != "$target" ]; then
        echo "⚠ Cambiando GPU: ${current:-desconocido} -> $target (requiere reboot)"
        sudo envycontrol -s "$target" "$@"
        NEEDS_REBOOT=1
    fi
}

case "$MODE" in
  --off)
    echo "[battery-mode] Restaurando modo NORMAL..."
    kill_swayidle

    gpu_switch hybrid --rtd3
    set_cpu_profile reset auto
    [ -n "$WIFI_IFACE" ] && sudo iw dev "$WIFI_IFACE" set power_save off 2>/dev/null
    rfkill unblock bluetooth 2>/dev/null

    if [ "$NEEDS_REBOOT" = "1" ]; then
        notify "Modo normal activado — reinicia para aplicar el cambio de GPU"
    else
        notify "Modo normal activado ✓"
    fi
    ;;

  --low)
    echo "[battery-mode] Activando modo AHORRO (sin reboot)..."
    kill_swayidle

    set_cpu_profile powersave never
    [ -n "$WIFI_IFACE" ] && sudo iw dev "$WIFI_IFACE" set power_save on 2>/dev/null

    notify "Modo ahorro activado ✓ (GPU en RTD3, sin reboot)"
    ;;

  --high)
    echo "[battery-mode] Activando modo AHORRO MÁXIMO (con reboot)..."
    kill_swayidle

    gpu_switch integrated
    set_cpu_profile powersave never
    [ -n "$WIFI_IFACE" ] && sudo iw dev "$WIFI_IFACE" set power_save on 2>/dev/null
    rfkill block bluetooth 2>/dev/null

    swayidle -w timeout 60 'hyprctl dispatch dpms off' resume 'hyprctl dispatch dpms on' &
    disown

    if [ "$NEEDS_REBOOT" = "1" ]; then
        notify "Modo ahorro máximo activado — REINICIA para apagar la NVIDIA"
    else
        notify "Modo ahorro máximo activado ✓"
    fi
    ;;

  --gaming)
    echo "[battery-mode] Activando modo GAMING..."
    kill_swayidle

    gpu_switch nvidia
    set_cpu_profile performance always
    rfkill unblock bluetooth 2>/dev/null
    [ -n "$WIFI_IFACE" ] && sudo iw dev "$WIFI_IFACE" set power_save off 2>/dev/null

    if [ "$NEEDS_REBOOT" = "1" ]; then
        notify "Modo gaming activado — REINICIA para usar la GPU dedicada"
    else
        notify "Modo gaming activado 🚀"
    fi
    ;;

  *)
    echo "Uso: battery-mode --off | --low | --high | --gaming"
    echo ""
    echo "  --off    Normal   (GPU hybrid+RTD3, CPU auto, sin reboot salvo cambio de GPU)"
    echo "  --low    Ahorro   (CPU powersave+turbo off, WiFi powersave, sin reboot)"
    echo "  --high   Ahorro máx. (+ GPU integrada, Bluetooth off, pantalla agresiva — con reboot)"
    echo "  --gaming Gaming   (CPU performance+turbo always, GPU dedicada — con reboot)"
    echo ""
    echo "Estado actual:"
    echo "  GPU:          $(envycontrol --query 2>/dev/null || echo 'no disponible')"
    echo "  Governor:     $(cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor 2>/dev/null || echo 'no disponible')"
    echo "  Turbo:        $(cat /sys/devices/system/cpu/intel_pstate/no_turbo 2>/dev/null | grep -q 1 && echo 'OFF' || echo 'ON')"
    echo "  TLP:          $(systemctl is-active tlp 2>/dev/null)"
    echo "  auto-cpufreq: $(systemctl is-active auto-cpufreq 2>/dev/null)"
    echo "  WiFi:         ${WIFI_IFACE:-'no detectada'}"
    ;;
esac
